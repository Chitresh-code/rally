// Prisma schema for Rally.
// Mirrors the ERD in docs/02-architecture.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) required models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Core domain ---

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  createdAt         DateTime  @default(now())
  notificationPrefs Json?

  accounts    Account[]
  sessions    Session[]
  memberships UserMembership[]
  guestShares GuestShare[]

  assignedTasks Task[]         @relation("TaskAssignees")
  createdTasks  Task[]         @relation("TaskCreator")
  comments      Comment[]
  attachments   Attachment[]
  messages      Message[]
  channels      Channel[]      @relation("ChannelMembers")
  spaceMembers  SpaceMember[]
  invitesSent   Invite[]       @relation("InvitesSent")
  notifications Notification[]
  channelReads  ChannelRead[]
}

model Workspace {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  slackWebhookUrl String?
  createdAt       DateTime @default(now())

  memberships UserMembership[]
  spaces      Space[]
  channels    Channel[]
  guestShares GuestShare[]
  invites     Invite[]
}

model UserMembership {
  id          String   @id @default(cuid())
  role        Role
  createdAt   DateTime @default(now())
  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Space {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  workspaceId String

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lists     List[]
  members   SpaceMember[]
  invites   Invite[]
}

model SpaceMember {
  id        String   @id @default(cuid())
  spaceId   String
  userId    String
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
}

model List {
  id          String    @id @default(cuid())
  name        String
  isSprint    Boolean   @default(false)
  sprintStart DateTime?
  sprintEnd   DateTime?
  createdAt   DateTime  @default(now())
  spaceId     String

  space        Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tasks        Task[]
  guestShares  GuestShare[]
  invites      Invite[]
  customFields CustomField[]
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  listId      String
  createdById String
  parentId    String?

  list      List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy User   @relation("TaskCreator", fields: [createdById], references: [id])
  parent    Task?  @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  Task[] @relation("Subtasks")

  assignees         User[]             @relation("TaskAssignees")
  dependsOn         TaskDependency[]   @relation("DependentTask")
  dependents        TaskDependency[]   @relation("DependsOnTask")
  comments          Comment[]
  attachments       Attachment[]
  messages          Message[]
  notifications     Notification[]
  checklistItems    ChecklistItem[]
  customFieldValues CustomFieldValue[]
}

model ChecklistItem {
  id        String   @id @default(cuid())
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  taskId    String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// One CustomField definition lives on a List (e.g. "Story Points" for a
// project's tasks); each Task in that list can have at most one value per
// field. Value is always stored as a string regardless of type (parsed/
// formatted in the UI) — avoids a column-per-type schema for four types.
model CustomField {
  id        String          @id @default(cuid())
  name      String
  type      CustomFieldType
  options   String[]        @default([])
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  listId    String

  list   List               @relation(fields: [listId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]
}

model CustomFieldValue {
  id            String @id @default(cuid())
  value         String
  taskId        String
  customFieldId String

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([taskId, customFieldId])
}

// A row means `task` depends on `dependsOn` (i.e. `dependsOn` blocks `task`).
// Modeled as an explicit join so direction is a real column, not inferred
// from a symmetric self-relation (Prisma self-relations with the same
// relation name on both sides are symmetric and can't represent a directed
// edge — using two names here keeps dependsOn/dependents genuinely distinct).
model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependsOnTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  text      String
  taskId    String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  taskId    String
  authorId  String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model Attachment {
  id           String   @id @default(cuid())
  url          String
  filename     String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  taskId       String
  uploadedById String

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

// --- Chat ---

model Channel {
  id          String   @id @default(cuid())
  name        String?
  isDirect    Boolean  @default(false)
  createdAt   DateTime @default(now())
  workspaceId String

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   User[]        @relation("ChannelMembers")
  messages  Message[]
  reads     ChannelRead[]
}

model ChannelRead {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Message {
  id              String   @id @default(cuid())
  body            String
  createdAt       DateTime @default(now())
  channelId       String
  authorId        String
  parentMessageId String?
  taskId          String?

  channel       Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id])
  parentMessage Message?  @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies       Message[] @relation("MessageReplies")
  task          Task?     @relation(fields: [taskId], references: [id])
}

// --- Guest access ---
// A guest's UserMembership has role GUEST. GuestShare scopes exactly which
// lists that guest can see, everything else in the workspace stays hidden.

model GuestShare {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  workspaceId String
  userId      String
  listId      String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  list      List      @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
}

// --- Invites ---
// Onboarding is invite-only: an Owner invites Admins, Admins invite Members
// (into spaces they manage) and Guests (into lists they can edit).

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  token       String    @unique
  workspaceId String
  invitedById String?
  spaceId     String?
  listId      String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitesSent", fields: [invitedById], references: [id])
  space     Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  list      List?     @relation(fields: [listId], references: [id], onDelete: Cascade)
}
