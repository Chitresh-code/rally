# Copy this file to .env and fill in real values.

# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://rally:rally_dev_password@localhost:5432/rally_dev?schema=public"

# Base URL this app is served at — used to build invite links sent by email.
APP_URL="http://localhost:3000"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Magic link email (SMTP). Fill in before magic link login will actually send mail.
EMAIL_SERVER="smtp://user:pass@localhost:1025"
EMAIL_FROM="Rally <no-reply@rally.local>"

# Owner bootstrap (src/lib/bootstrap.ts) — on server start, if no user with this
# email is registered as the workspace owner yet, an invite is created for them
# (emailed, and logged to the server console) to set their password and become
# the Owner. No password is ever stored in env.
SEED_OWNER_EMAIL="owner@yourorg.com"
